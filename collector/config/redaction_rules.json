{
  "patterns": [
    {
      "name": "password_kv",
      "regex": "(?i)(password|passwd|pwd|secret|api_key|apikey|token)\\s*[=:]\\s*[^\\s,;\"']+",
      "replacement": "$1=[REDACTED_SECRET]"
    },
    {
      "name": "bearer_jwt",
      "regex": "(?i)Bearer\\s+[A-Za-z0-9\\-._~+/]+=*",
      "replacement": "Bearer [REDACTED_TOKEN]"
    },
    {
      "name": "email_address",
      "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "replacement": "[REDACTED_EMAIL]"
    },
    {
      "name": "ipv4_private",
      "regex": "\\b(?:10\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])|192\\.168)\\.\\d{1,3}\\.\\d{1,3}\\b",
      "replacement": "[REDACTED_PRIVATE_IP]"
    },
    {
      "name": "card_number",
      "regex": "\\b(?:\\d[ -]*?){13,16}\\b",
      "replacement": "[REDACTED_PAN]"
    }
  ],
  "allow_list_fields": [
    "metric_name",
    "metric_value",
    "unit",
    "timestamp_utc",
    "source_timezone",
    "source_id",
    "health_state",
    "event_category",
    "severity",
    "alert_context",
    "collector_id",
    "site_id",
    "tenant_id",
    "payload_id",
    "source",
    "connector",
    "collection_interval"
  ]
}
