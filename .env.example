# GEMINI_API_KEY: Optional for Gemini AI API calls if added later.
GEMINI_API_KEY=""

# APP_URL: Automatically injected by the runtime host.
APP_URL=""

# ---------------------------------------------------------------------------
# TIER 2 PLUGGABLE STORAGE (Zero external accounts required)
# STORAGE_BACKEND=postgres | supabase (defaults to local postgres in compose)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=postgres
DATABASE_URL=

# Optional Supabase override (used SERVER-SIDE ONLY when STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend same-origin defaults (leave blank in integrated preview; set for split deploy)
VITE_SAAS_API_URL=
VITE_COLLECTOR_API_URL=

# MailHog / SMTP settings (defaults to local MailHog 127.0.0.1:1025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aurelis.local

# Optional cryptographic overrides (auto-generated via CSPRNG if empty)
AURELIS_SOURCE_ID_SALT=
AURELIS_COLLECTOR_SECRET=
